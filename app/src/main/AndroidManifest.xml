<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="amzn" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSTALL_PACKAGE" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
        <package android:name="com.android.vending" />
        <package android:name="com.amazon.venezia" />
        <package android:name="com.aurora.store" />
        <package android:name="cm.aptoidetv.pt" />
        <package android:name="com.xiaomi.mitv.appstore" />
        <package android:name="com.gitvdemo.video" />
        <package android:name="com.ktcp.video" />
        <package android:name="com.cibn.tv" />
        <package android:name="com.hunantv.license" />
        <package android:name="com.xiaodianshi.tv.yst" />
        <package android:name="com.newtv.cboxtv" />
        <package android:name="com.tencent.qqmusictv" />
        <package android:name="com.google.android.gms" />
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="com.google.android.apps.youtube.unplugged" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.google.android.youtube.googletv" />
        <package android:name="com.amazon.firetv.youtube" />
        <package android:name="org.smarttube.stable" />
        <package android:name="org.smarttube.beta" />
        <package android:name="app.smarttube.fdroid" />
        <package android:name="com.liskovsoft.smarttubetv.beta" />
        <package android:name="com.teamsmart.videomanager.tv" />
        <package android:name="com.netflix.ninja" />
        <package android:name="com.disney.disneyplus" />
        <package android:name="com.google.android.videos" />
        <package android:name="com.android.chrome" />
        <package android:name="com.amazon.amazonvideo.livingroom" />
        <package android:name="com.plexapp.android" />
        <package android:name="com.spotify.tv.android" />
        <package android:name="com.apple.atve.androidtv.appletv" />
        <package android:name="com.wbd.stream" />
        <package android:name="com.cbs.ott" />
        <package android:name="com.crunchyroll.crunchyroid" />
        <package android:name="tv.twitch.android.app" />
        <package android:name="tv.pluto.android" />
        <package android:name="com.tubitv" />
        <package android:name="com.recipe.filmrise" />
        <package android:name="com.future.moviesByFawesomeAndroidTV" />
        <package android:name="com.xumo.xumo.tv" />
        <package android:name="com.dazn" />
        <package android:name="com.discoveryplus.tv.android" />
        <package android:name="com.discovery.discoveryplus.mobile" />
        <package android:name="com.discovery.discoveryplus.firetv" />
        <package android:name="com.sling" />
        <package android:name="tv.fubo.mobile" />
        <package android:name="com.espn.score_center" />
        <package android:name="com.formulaone.production" />
        <package android:name="com.mubi" />
        <package android:name="com.britbox.tv" />
        <package android:name="com.hulu.livingroomplus" />
        <package android:name="com.peacocktv.peacockandroid" />
        <package android:name="com.univision.prendetv" />
        <package android:name="com.globo.globotv" />
        <package android:name="com.iqiyi.i18n.tv" />
        <package android:name="com.viki.android" />
        <package android:name="net.mbc.shahidTV" />
        <package android:name="in.startv.hotstar" />
        <package android:name="tv.ifvod.classic" />
        <package android:name="com.kanopy.tvapp" />
        <package android:name="jp.co.rakuten.channel.tv.google" />
        <package android:name="tv.emby.embyatv" />
        <package android:name="com.stremio.one" />
        <package android:name="com.limelight" />
        <package android:name="com.valvesoftware.steamlink" />
        <package android:name="com.sonyliv" />
        <package android:name="com.vuclip.viu" />
        <package android:name="com.graymatrix.did" />
        <package android:name="org.jellyfin.androidtv" />
        <package android:name="org.xbmc.kodi" />
        <package android:name="org.videolan.vlc" />
        <package android:name="com.github.metacubex.clash.meta" />
        <package android:name="com.tailscale.ipn" />
        <package android:name="com.wireguard.android" />
        <package android:name="de.blinkt.openvpn" />
        <package android:name="app.aptelly.fixture.upgrade" />
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/aptelly_tv_banner"
        android:icon="@drawable/aptelly_tv_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Aptelly"
        android:usesCleartextTraffic="${usesCleartextTraffic}">

        <activity
            android:name=".MainActivity"
            android:banner="@drawable/aptelly_tv_banner"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|uiMode"
            android:exported="true"
            android:icon="@drawable/aptelly_tv_launcher"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter android:priority="2">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.HOME" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AppManagerActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|uiMode"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".BrowserActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|uiMode"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".EnvironmentActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|uiMode"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".PrimeVideoShortcutActivity"
            android:banner="@drawable/brand_prime"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/brand_prime"
            android:label="@string/prime_video_shortcut_label"
            android:noHistory="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Aptelly">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".TvAppShortcutActivity$Plex"
            android:banner="@drawable/brand_plex"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/brand_plex"
            android:label="@string/plex_shortcut_label"
            android:noHistory="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Aptelly">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.DEFAULT" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <activity
            android:name=".TvAppShortcutActivity$Fawesome"
            android:banner="@drawable/brand_fawesome" android:enabled="false"
            android:exported="true" android:icon="@drawable/brand_fawesome"
            android:label="@string/fawesome_shortcut_label" android:noHistory="true"
            android:screenOrientation="landscape" android:theme="@style/Theme.Aptelly">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.DEFAULT" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <activity
            android:name=".TvAppShortcutActivity$Crunchyroll"
            android:banner="@drawable/brand_crunchyroll" android:enabled="false"
            android:exported="true" android:icon="@drawable/brand_crunchyroll"
            android:label="@string/crunchyroll_shortcut_label" android:noHistory="true"
            android:screenOrientation="landscape" android:theme="@style/Theme.Aptelly">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.DEFAULT" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <activity
            android:name=".TvAppShortcutActivity$Espn"
            android:banner="@drawable/brand_espn" android:enabled="false"
            android:exported="true" android:icon="@drawable/brand_espn"
            android:label="@string/espn_shortcut_label" android:noHistory="true"
            android:screenOrientation="landscape" android:theme="@style/Theme.Aptelly">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.DEFAULT" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <activity
            android:name=".TvAppShortcutActivity$F1"
            android:banner="@drawable/brand_f1" android:enabled="false"
            android:exported="true" android:icon="@drawable/brand_f1"
            android:label="@string/f1_shortcut_label" android:noHistory="true"
            android:screenOrientation="landscape" android:theme="@style/Theme.Aptelly">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.DEFAULT" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <activity
            android:name=".TvAppShortcutActivity$BritBox"
            android:banner="@drawable/brand_britbox" android:enabled="false"
            android:exported="true" android:icon="@drawable/brand_britbox"
            android:label="@string/britbox_shortcut_label" android:noHistory="true"
            android:screenOrientation="landscape" android:theme="@style/Theme.Aptelly">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.DEFAULT" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <activity
            android:name=".TvAppShortcutActivity$Globoplay"
            android:banner="@drawable/brand_globoplay" android:enabled="false"
            android:exported="true" android:icon="@drawable/brand_globoplay"
            android:label="@string/globoplay_shortcut_label" android:noHistory="true"
            android:screenOrientation="landscape" android:theme="@style/Theme.Aptelly">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.DEFAULT" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <activity
            android:name=".TvAppShortcutActivity$JioHotstar"
            android:banner="@drawable/brand_jiohotstar" android:enabled="false"
            android:exported="true" android:icon="@drawable/brand_jiohotstar"
            android:label="@string/jiohotstar_shortcut_label" android:noHistory="true"
            android:screenOrientation="landscape" android:theme="@style/Theme.Aptelly">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.DEFAULT" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <activity
            android:name=".TvAppShortcutActivity$DiscoveryPlus"
            android:banner="@drawable/brand_discovery" android:enabled="false"
            android:exported="true" android:icon="@drawable/brand_discovery"
            android:label="@string/discovery_shortcut_label" android:noHistory="true"
            android:screenOrientation="landscape" android:theme="@style/Theme.Aptelly">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.DEFAULT" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>

        <receiver
            android:name=".install.InstallStatusReceiver"
            android:exported="false" />

        <receiver
            android:name=".PrimeVideoShortcutReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
